
 //VSAMCRT JOB (ACCT),'VSAM CREATE',CLASS=A,MSGCLASS=X
 //* CREATE VSAM KSDS FOR BANKING RECONCILIATION
 //* PROPOSED RECORD LAYOUT: 38 BYTES
 //* KEY: TXN_ID, LENGTH 10, STARTING AT POSITION 1
 //* CONFIRM DATASET NAMES AND ATTRIBUTES BEFORE SUBMISSION
 //STEP1    EXEC PGM=IDCAMS
 //SYSPRINT DD SYSOUT=*
 //SYSIN    DD *
   DEFINE CLUSTER ( -
     NAME(YOURID.RECON.REF.KSDS) -
     INDEXED -
     KEYS(10 0) -
     RECORDSIZE(38 38) -
     TRACKS(5 2) -
     FREESPACE(10 10) -
     SHAREOPTIONS(2 3) -
   ) -
   DATA ( -
     NAME(YOURID.RECON.REF.KSDS.DATA) -
   ) -
   INDEX ( -
     NAME(YOURID.RECON.REF.KSDS.INDEX) -
   )
 /*
