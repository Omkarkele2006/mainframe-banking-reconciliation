NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/banking-reconciliation
UPLOAD_DIR=./server/.uploads
MAX_UPLOAD_BYTES=10485760
# Mainframe values are server-only and must be supplied by the authorized administrator.
MAINFRAME_ENABLED=false
MAINFRAME_RECONCILIATION_ENABLED=false
# Dataset Explorer mutations use the backend's local `zosmf` profile and are
# independent of reconciliation/job execution. Scope is the assigned personal
# HLQ; the server writes only manifest-owned Z73968.Uxxxxxxx.DATA resources.
MAINFRAME_DATASET_MUTATIONS_ENABLED=false
MAINFRAME_DATASET_MUTATION_SCOPE=
# Dedicated gate for server-owned NOOP_SMOKE and the generated run-scoped input
# sort/settlement-duplicate preflight only. It does not enable VSAM/COBOL/EOD
# reconciliation. Independent from dataset CRUD; requires MAINFRAME_JOB_CLASS.
MAINFRAME_JOB_SUBMISSION_ENABLED=false
# Explicitly acknowledges the existing local Zowe profile's TLS risk for live
# banking input preflight and any future reconciliation; it does not validate
# certificates, alter Zowe settings, or enable reconciliation by itself.
MAINFRAME_RECONCILIATION_TLS_RISK_ACCEPTED=false
MAINFRAME_ENDPOINT=
MAINFRAME_HLQ=
# Optional server-only read masks for Dataset Explorer, comma-separated (e.g. Z73968.BANK.*).
# Every mask must be within MAINFRAME_HLQ. Empty means dataset browsing is unavailable.
MAINFRAME_DATASET_READ_SCOPES=
MAINFRAME_JOB_CLASS=
MAINFRAME_SOURCE_LIBRARY=
MAINFRAME_LOAD_LIBRARY=
MAINFRAME_AUTH_READY=false
MAINFRAME_LOCAL_UPLOAD_TLS_RISK_ACCEPTED=false
MAINFRAME_UPLOAD_TEST_REVIEWED=false
# Read-only check invokes the local Zowe CLI `zosmf` profile. Never export profile secrets.
ZOWE_CLI_TIMEOUT_MS=45000
# Optional: set NODE_EXTRA_CA_CERTS in the server environment to a trusted PEM CA bundle path.
# Protected operations fail closed until the administrator configures an operator and scrypt hash.
APP_OPERATOR_USERNAME=
APP_OPERATOR_PASSWORD_SCRYPT=
APP_SESSION_TTL_SECONDS=1800
