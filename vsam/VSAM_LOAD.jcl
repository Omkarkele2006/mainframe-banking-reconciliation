//VSAMLOAD JOB (ACCT),'VSAM LOAD',CLASS=A,MSGCLASS=X
//* OPTIONAL STANDALONE VSAM EXTENSION - NOT USED BY MASTER.JCL
//* LOAD REFERENCE RECORDS ONLY AFTER THE VSAM LAYOUT AND DATASET ARE APPROVED
//* INPUT MUST EXIST AND CONTAIN VALID 38-BYTE RECORDS
//STEP1    EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//INPUT    DD DSN=Z73968.BANK.RECON.REF.INPUT,DISP=SHR
//SYSIN    DD *
  REPRO INFILE(INPUT) -
        OUTDATASET(Z73968.BANK.RECON.REF.KSDS)
/*