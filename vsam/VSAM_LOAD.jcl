//VSAMLOAD JOB (ACCT),'VSAM LOAD',CLASS=A,MSGCLASS=X
//* LOAD REFERENCE RECORDS INTO VSAM KSDS
//* INPUT RECORDS MUST MATCH THE AGREED RECORD LAYOUT
//* CONFIRM DATASET NAMES BEFORE SUBMISSION
//STEP1    EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//INPUT    DD DSN=YOURID.RECON.REF.INPUT,DISP=SHR
//SYSIN    DD *
  REPRO INFILE(INPUT) -
        OUTDATASET(YOURID.RECON.REF.KSDS)
/*
