//VSAMLOAD JOB (ACCT),'VSAM LOAD',CLASS=A,MSGCLASS=X
//* LOAD REFERENCE RECORDS INTO BANKING RECONCILIATION KSDS
//* INPUT MUST EXIST AND CONTAIN VALID 38-BYTE RECORDS
//STEP1    EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//INPUT    DD DSN=Z73736.RECON.REF.INPUT,DISP=SHR
//SYSIN    DD *
  REPRO INFILE(INPUT) -
        OUTDATASET(Z73736.RECON.REF.KSDS)
/*