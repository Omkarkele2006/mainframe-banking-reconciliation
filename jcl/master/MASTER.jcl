//BANKMAST JOB ,MSGLEVEL=(2,0),CLASS=7
//* INTEGRATION TEMPLATE FOR THE CURRENT 5-RECORD DUPLICATE/NORMAL TEST.
//* Prerequisites before submission:
//* 1. Z73968.BANK.REXXLIB(VALIDATE) exists and validates TXNSORT/SETSORT.
//* 2. Z73968.BANK.LOAD contains the compiled COBOL load module RECONCIL.
//* 3. RECONCIL uses DD names TRANIN, SETTIN, MATCHOUT, MISMOUT, TXNMISS,
//*    SETMISS and writes 38-byte MATCHOUT plus 120-byte exception records.
//* 4. Delete previously cataloged output datasets before re-running this job.
//* This template is not ready to run until REXX/COBOL interfaces are implemented.
//TXNSORT  EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=Z73968.BANK.TXNTEST,DISP=SHR
//SORTOUT  DD DSN=Z73968.BANK.TXNSORT,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1)),
//            UNIT=SYSDA,
//            DCB=(RECFM=FB,LRECL=38,BLKSIZE=0)
//SYSIN    DD *
  SORT FIELDS=(1,10,CH,A)
  SUM FIELDS=NONE
/*
//SETSORT  EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=Z73968.BANK.SETTEST,DISP=SHR
//SORTOUT  DD DSN=Z73968.BANK.SETSORT,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1)),
//            UNIT=SYSDA,
//            DCB=(RECFM=FB,LRECL=38,BLKSIZE=0)
//SYSIN    DD *
  SORT FIELDS=(1,10,CH,A)
/*
//SORTOK   IF (TXNSORT.RC = 0 & SETSORT.RC = 0) THEN
//REXXVAL  EXEC PGM=IKJEFT01,DYNAMNBR=20
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *
  EXEC 'Z73968.BANK.REXXLIB(VALIDATE)'
/*
//REXXOK   IF (REXXVAL.RC = 0) THEN
//RECONCIL EXEC PGM=RECONCIL
//STEPLIB  DD DSN=Z73968.BANK.LOAD,DISP=SHR
//TRANIN   DD DSN=Z73968.BANK.TXNSORT,DISP=SHR
//SETTIN   DD DSN=Z73968.BANK.SETSORT,DISP=SHR
//MATCHOUT DD DSN=Z73968.BANK.MATCHED,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1)),
//            UNIT=SYSDA,
//            DCB=(RECFM=FB,LRECL=38,BLKSIZE=0)
//MISMOUT  DD DSN=Z73968.BANK.MISMATCH,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1)),
//            UNIT=SYSDA,
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//TXNMISS  DD DSN=Z73968.BANK.TXNMISS,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1)),
//            UNIT=SYSDA,
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//SETMISS  DD DSN=Z73968.BANK.SETMISS,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1)),
//            UNIT=SYSDA,
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//RECONOK  IF (RECONCIL.RC = 0) THEN
//* EOD count checks for the current 5-record happy-path fixture.
//TXNCNT   EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//TXNIN    DD DSN=Z73968.BANK.TXNSORT,DISP=SHR
//TOOLIN   DD *
  COUNT FROM(TXNIN) NOTEQUAL(5) RC8
/*
//SETCNT   EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//SETIN    DD DSN=Z73968.BANK.SETSORT,DISP=SHR
//TOOLIN   DD *
  COUNT FROM(SETIN) NOTEQUAL(5) RC8
/*
//MATCHCT  EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//MATCHIN  DD DSN=Z73968.BANK.MATCHED,DISP=SHR
//TOOLIN   DD *
  COUNT FROM(MATCHIN) NOTEQUAL(5) RC8
/*
//MISCT    EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//MISM     DD DSN=Z73968.BANK.MISMATCH,DISP=SHR
//TOOLIN   DD *
  COUNT FROM(MISM) NOTEQUAL(0) RC8
/*
//TNMCT    EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//TNMISS   DD DSN=Z73968.BANK.TXNMISS,DISP=SHR
//TOOLIN   DD *
  COUNT FROM(TNMISS) NOTEQUAL(0) RC8
/*
//STMCT    EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//STMISS   DD DSN=Z73968.BANK.SETMISS,DISP=SHR
//TOOLIN   DD *
  COUNT FROM(STMISS) NOTEQUAL(0) RC8
/*
//PUBOK    IF (TXNCNT.RC = 0 & SETCNT.RC = 0 &
//            MATCHCT.RC = 0 & MISCT.RC = 0 &
//            TNMCT.RC = 0 & STMCT.RC = 0) THEN
//FINALCP  EXEC PGM=IEBGENER
//SYSUT1   DD DSN=Z73968.BANK.MATCHED,DISP=SHR
//SYSUT2   DD DSN=Z73968.BANK.FINAL,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1)),
//            UNIT=SYSDA,
//            DCB=(RECFM=FB,LRECL=38,BLKSIZE=0)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//PUBEND   ENDIF
//EODFAIL  IF (TXNCNT.RC > 0 | SETCNT.RC > 0 |
//             MATCHCT.RC > 0 | MISCT.RC > 0 |
//             TNMCT.RC > 0 | STMCT.RC > 0) THEN
//ERRWRITE EXEC PGM=IEBGENER
//SYSUT1   DD *
EOD VALIDATION FAILED - FINAL OUTPUT NOT PUBLISHED
Inspect ICETOOL TOOLMSG/DFSMSG for the count that failed.
/*
//SYSUT2   DD DSN=Z73968.BANK.EODERROR,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1)),
//            UNIT=SYSDA,
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//FAILEND  ENDIF
//RECONEND ENDIF
//REXXEND  ENDIF
//SORTEND  ENDIF
