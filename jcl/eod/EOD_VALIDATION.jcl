//EODVAL   JOB ,MSGLEVEL=(2,0),CLASS=7
//* Standalone EOD gate for the SMOKE_DUPLICATE profile only.
//* Preconditions: COBOL completed with RC=0 and created all four outputs.
//* Expected: TXNSORT=5, SETSORT=5, MATCHED=5, MISMATCH=0,
//* TXNMISS=0, SETMISS=0. A passing gate publishes FINAL only.
//* This is not the 10,000-record volume profile.
//* Before rerun, remove only prior outputs: FINAL and EODERROR.
//TXNCHK   EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//TXNIN    DD DSN=Z73968.BANK.TXNSORT,DISP=SHR
//TOOLIN   DD *
  COUNT FROM(TXNIN) NOTEQUAL(5) RC8
/*
//SETCHK   EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//SETIN    DD DSN=Z73968.BANK.SETSORT,DISP=SHR
//TOOLIN   DD *
  COUNT FROM(SETIN) NOTEQUAL(5) RC8
/*
//MATCHCHK EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//MATCHIN  DD DSN=Z73968.BANK.MATCHED,DISP=SHR
//TOOLIN   DD *
  COUNT FROM(MATCHIN) NOTEQUAL(5) RC8
/*
//MISMCHK  EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//MISM     DD DSN=Z73968.BANK.MISMATCH,DISP=SHR
//TOOLIN   DD *
  COUNT FROM(MISM) NOTEQUAL(0) RC8
/*
//TNMCHK   EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//TXNMISS  DD DSN=Z73968.BANK.TXNMISS,DISP=SHR
//TOOLIN   DD *
  COUNT FROM(TXNMISS) NOTEQUAL(0) RC8
/*
//STMCHK   EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//SETMISS  DD DSN=Z73968.BANK.SETMISS,DISP=SHR
//TOOLIN   DD *
  COUNT FROM(SETMISS) NOTEQUAL(0) RC8
/*
//PUBOK    IF (TXNCHK.RC = 0 & SETCHK.RC = 0 &
//            MATCHCHK.RC = 0 & MISMCHK.RC = 0 &
//            TNMCHK.RC = 0 & STMCHK.RC = 0) THEN
//FINALCP  EXEC PGM=IEBGENER
//SYSUT1   DD DSN=Z73968.BANK.MATCHED,DISP=SHR
//SYSUT2   DD DSN=Z73968.BANK.FINAL,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1)),
//            UNIT=SYSDA,
//            DCB=(RECFM=FB,LRECL=38,BLKSIZE=0)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//PUBEND   ENDIF
//EODFAIL  IF (TXNCHK.RC > 0 | SETCHK.RC > 0 | MATCHCHK.RC > 0 |
//            MISMCHK.RC > 0 | TNMCHK.RC > 0 | STMCHK.RC > 0 |
//            FINALCP.RC > 0) THEN
//ERRWRITE EXEC PGM=IEBGENER
//SYSUT1   DD *
EOD VALIDATION FAILED - FINAL OUTPUT NOT PUBLISHED
Inspect ICETOOL TOOLMSG/DFSMSG for the count that failed.
/*
//SYSUT2   DD DSN=Z73968.BANK.EODERROR,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1)),
//            UNIT=SYSDA,
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//FAILEND  ENDIF
