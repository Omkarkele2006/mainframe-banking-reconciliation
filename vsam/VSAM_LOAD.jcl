//VSAMLOAD JOB (ACCT),'VSAM LOAD',CLASS=A,MSGCLASS=X
//* REPEATABLE LOAD OF THE ALREADY-DEFINED KSDS
//* INPUT MUST EXIST AND CONTAIN VALID 38-BYTE RECORDS
//STEP1    EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//INPUT    DD DSN=Z73968.BANK.SETSORT,DISP=SHR
//SYSIN    DD *
  REPRO INFILE(INPUT) -
        REPLACE -
        OUTDATASET(Z73968.BANK.RECON.REF.KSDS)
/*