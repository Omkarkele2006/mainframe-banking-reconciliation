//S9C5PMVC JOB ,MSGLEVEL=(2,0),CLASS=7,TYPRUN=SCAN
//VSAMCRT  EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DEFINE CLUSTER ( -
    NAME(Z73968.S9C5PMVC.SETTLE) -
    INDEXED KEYS(10 0) RECORDSIZE(38 38) TRACKS(1 1) -
    DATA (NAME(Z73968.S9C5PMVC.SETDATA)) -
    INDEX (NAME(Z73968.S9C5PMVC.SETIDX)) )
/*
//IFCRT    IF (VSAMCRT.RC = 0) THEN
//VSAMLOAD EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//INPUT    DD DSN=Z73968.S9C5PMVC.SETSORT,DISP=SHR
//SYSIN    DD *
  REPRO INFILE(INPUT) OUTDATASET(Z73968.S9C5PMVC.SETTLE)
/*
//IFLOAD   IF (VSAMLOAD.RC = 0) THEN
//RECONCIL EXEC PGM=RECONCIL
//STEPLIB  DD DSN=Z73968.LOAD,DISP=SHR
//TRANIN   DD DSN=Z73968.S9C5PMVC.TXNSORT,DISP=SHR
//SETTIN   DD DSN=Z73968.S9C5PMVC.SETTLE,DISP=SHR
//MATCHOUT DD DSN=Z73968.S9C5PMVC.MATCHOUT,DISP=(NEW,CATLG,KEEP),
//         SPACE=(TRK,(1)),UNIT=SYSDA,
//         DCB=(DSORG=PS,RECFM=FB,LRECL=38,BLKSIZE=0)
//MISMOUT  DD DSN=Z73968.S9C5PMVC.MISMOUT,DISP=(NEW,CATLG,KEEP),
//         SPACE=(TRK,(1)),UNIT=SYSDA,
//         DCB=(DSORG=PS,RECFM=FB,LRECL=120,BLKSIZE=0)
//TXNMISS  DD DSN=Z73968.S9C5PMVC.TXNMISS,DISP=(NEW,CATLG,KEEP),
//         SPACE=(TRK,(1)),UNIT=SYSDA,
//         DCB=(DSORG=PS,RECFM=FB,LRECL=120,BLKSIZE=0)
//SETMISS  DD DSN=Z73968.S9C5PMVC.SETMISS,DISP=(NEW,CATLG,KEEP),
//         SPACE=(TRK,(1)),UNIT=SYSDA,
//         DCB=(DSORG=PS,RECFM=FB,LRECL=120,BLKSIZE=0)
//ENDIFLD  ENDIF
//ENDIFCR  ENDIF
