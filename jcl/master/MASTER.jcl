//BANKMAST JOB ,MSGLEVEL=(2,0),CLASS=7
//* PROFILE: SMOKE_DUPLICATE (current Z73968 test datasets).
//* Known fixture: TXNTEST=7; TXNSORT=5 after key deduplication.
//* Known fixture: SETTEST=5; SETSORT=5 (sort only; preserve duplicates).
//* EOD PASS: TXNSORT=5, SETSORT=5, MATCHED=5, other outputs=0.
//* This is NOT the 10,000-record volume profile.
//* Before rerun, delete only cataloged intermediate/output datasets:
//* TXNSORT, SETSORT, MATCHED, MISMATCH, TXNMISS, SETMISS, FINAL, EODERROR.
//* Never delete TXNTEST or SETTEST when doing cleanup.
//* REXX member VALIDATE must check TXNSORT and SETSORT (post-sort inputs).
//* COBOL input DDs: TRANIN, SETTIN. Output DDs: MATCHOUT, MISMOUT,
//* TXNMISS, SETMISS. MATCHOUT=FB/38; exception outputs=FB/120.
//* RC contract: 0=clean; 4=business exceptions; >=8=technical failure.
//* EOD runs for RC=0 or RC=4; FINAL requires RC=0 and passing counts.
//* Current path is file-based COBOL with a VSAM settlement KSDS.
//* Create Z73968.BANK.RECON.REF.KSDS once with VSAM/VSAM_CREATE.jcl.
//TXNSORT  EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=Z73968.BANK.TXNTEST,DISP=SHR
//SORTOUT  DD DSN=Z73968.BANK.TXNSORT,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1)),
//            UNIT=SYSDA,
//            DCB=(RECFM=FB,LRECL=38,BLKSIZE=0)
//SYSIN    DD *
  SORT FIELDS=(1,10,CH,A)
  SUM FIELDS=NONE
/*
//SETSORT  EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=Z73968.BANK.SETTEST,DISP=SHR
//SORTOUT  DD DSN=Z73968.BANK.SETSORT,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1)),
//            UNIT=SYSDA,
//            DCB=(RECFM=FB,LRECL=38,BLKSIZE=0)
//SYSIN    DD *
  SORT FIELDS=(1,10,CH,A)
/*
//SORTOK   IF (TXNSORT.RC = 0 & SETSORT.RC = 0) THEN
//REXXVAL  EXEC PGM=IKJEFT01,DYNAMNBR=20
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *
  EXEC 'Z73968.SOURCE(VALIDATE)'
/*
//REXXOK   IF (REXXVAL.RC = 0) THEN
//VSAMREP  EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//INPUT    DD DSN=Z73968.BANK.SETSORT,DISP=SHR
//SYSIN    DD *
  REPRO INFILE(INPUT) -
        REPLACE -
        OUTDATASET(Z73968.BANK.RECON.REF.KSDS)
/*
//REPROOK IF (VSAMREP.RC = 0) THEN
//RECONCIL EXEC PGM=RECONCIL
//STEPLIB  DD DSN=Z73968.LOAD,DISP=SHR
//TRANIN   DD DSN=Z73968.BANK.TXNSORT,DISP=SHR
//SETTIN   DD DSN=Z73968.BANK.RECON.REF.KSDS,DISP=SHR
//MATCHOUT DD DSN=Z73968.BANK.MATCHED,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1)),
//            UNIT=SYSDA,
//            DCB=(RECFM=FB,LRECL=38,BLKSIZE=0)
//MISMOUT  DD DSN=Z73968.BANK.MISMATCH,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1)),
//            UNIT=SYSDA,
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//TXNMISS  DD DSN=Z73968.BANK.TXNMISS,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1)),
//            UNIT=SYSDA,
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//SETMISS  DD DSN=Z73968.BANK.SETMISS,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1)),
//            UNIT=SYSDA,
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//RECONOK  IF (RECONCIL.RC = 0 | RECONCIL.RC = 4) THEN
//TXNCNT   EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//TXNIN    DD DSN=Z73968.BANK.TXNSORT,DISP=SHR
//TOOLIN   DD *
  COUNT FROM(TXNIN) NOTEQUAL(5) RC8
/*
//SETCNT   EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//SETIN    DD DSN=Z73968.BANK.SETSORT,DISP=SHR
//TOOLIN   DD *
  COUNT FROM(SETIN) NOTEQUAL(5) RC8
/*
//MATCHCT  EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//MATCHIN  DD DSN=Z73968.BANK.MATCHED,DISP=SHR
//TOOLIN   DD *
  COUNT FROM(MATCHIN) NOTEQUAL(5) RC8
/*
//MISCT    EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//MISM     DD DSN=Z73968.BANK.MISMATCH,DISP=SHR
//TOOLIN   DD *
  COUNT FROM(MISM) NOTEQUAL(0) RC8
/*
//TNMCT    EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//TXNMISS  DD DSN=Z73968.BANK.TXNMISS,DISP=SHR
//TOOLIN   DD *
  COUNT FROM(TXNMISS) NOTEQUAL(0) RC8
/*
//STMCT    EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//SETMISS  DD DSN=Z73968.BANK.SETMISS,DISP=SHR
//TOOLIN   DD *
  COUNT FROM(SETMISS) NOTEQUAL(0) RC8
/*
//PUBOK    IF (RECONCIL.RC = 0 & TXNCNT.RC = 0 &
//            SETCNT.RC = 0 & MATCHCT.RC = 0 &
//            MISCT.RC = 0 & TNMCT.RC = 0 & STMCT.RC = 0)
//            THEN
//FINALCP  EXEC PGM=IEBGENER
//SYSUT1   DD DSN=Z73968.BANK.MATCHED,DISP=SHR
//SYSUT2   DD DSN=Z73968.BANK.FINAL,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1)),
//            UNIT=SYSDA,
//            DCB=(RECFM=FB,LRECL=38,BLKSIZE=0)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//PUBEND   ENDIF
//RECONEND ENDIF
//REPROEND ENDIF
//REXXEND  ENDIF
//SORTEND  ENDIF
//* One common failure marker for sort, REXX, COBOL, EOD or publish errors.
//EODFAIL  IF (TXNSORT.RC > 0 | SETSORT.RC > 0 | REXXVAL.RC > 0 |
//            VSAMREP.RC > 0 |
//            RECONCIL.RC > 0 | TXNCNT.RC > 0 | SETCNT.RC > 0 |
//            MATCHCT.RC > 0 | MISCT.RC > 0 | TNMCT.RC > 0 |
//            STMCT.RC > 0 | FINALCP.RC > 0) THEN
//ERRWRITE EXEC PGM=IEBGENER
//SYSUT1   DD *
BATCH/EOD FAILED - FINAL OUTPUT NOT PUBLISHED
Inspect JES/SDSF and ICETOOL TOOLMSG/DFSMSG for the failure.
/*
//SYSUT2   DD DSN=Z73968.BANK.EODERROR,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1)),
//            UNIT=SYSDA,
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//FAILEND  ENDIF
