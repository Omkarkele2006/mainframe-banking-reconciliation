//VSAMCRT JOB (ACCT),'VSAM CREATE',CLASS=A,MSGCLASS=X
//* OPTIONAL STANDALONE VSAM EXTENSION - NOT USED BY MASTER.JCL
//* CREATE BANKING RECONCILIATION REFERENCE KSDS ONLY IF SEPARATELY APPROVED
//* RECORD LENGTH: 38 BYTES
//* KEY: TXN_ID, LENGTH 10, POSITION 1
//STEP1    EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DEFINE CLUSTER ( -
    NAME(Z73968.BANK.RECON.REF.KSDS) -
    INDEXED -
    KEYS(10 0) -
    RECORDSIZE(38 38) -
    TRACKS(5 2) -
    FREESPACE(10 10) -
    SHAREOPTIONS(2 3) -
  ) -
  DATA ( -
    NAME(Z73968.BANK.RECON.REF.KSDS.DATA) -
  ) -
  INDEX ( -
    NAME(Z73968.BANK.RECON.REF.KSDS.INDEX) -
  )
/*